From a46266bca137a104dcd06932e1c92de5767e4b2f Mon Sep 17 00:00:00 2001
From: David Csiki <csdivad@gmail.com>
Date: Sat, 12 Sep 2026 21:56:02 +0200
Subject: [PATCH] wayland-protocols: Drop frozen="true" interface attributes

wayland-scanner 1.23.1 (steamrt4 SDK) validates protocol XML against a DTD that does not declare the frozen interface attribute, so `wayland-scanner --strict enum-header` refuses to generate the enum headers for the two staging protocols that use it, breaking the steamrtdeps build.

The attribute is declarative metadata enforced only by wayland 1.25+ scanners; dropping it restores compatibility with the SDK scanner and leaves generated output unchanged.
---
 staging/color-management/color-management-v1.xml                | 2 +-
 .../ext-image-capture-source/ext-image-capture-source-v1.xml    | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/staging/color-management/color-management-v1.xml b/staging/color-management/color-management-v1.xml
index b47e108..eb2e869 100644
--- a/staging/color-management/color-management-v1.xml
+++ b/staging/color-management/color-management-v1.xml
@@ -1736,7 +1736,7 @@
     </event>
   </interface>
 
-  <interface name="wp_image_description_reference_v1" version="1" frozen="true">
+  <interface name="wp_image_description_reference_v1" version="1">
     <description summary="Reference to an image description">
       This object is a reference to an image description. This interface is
       frozen at version 1 to allow other protocols to create
diff --git a/staging/ext-image-capture-source/ext-image-capture-source-v1.xml b/staging/ext-image-capture-source/ext-image-capture-source-v1.xml
index e0808c2..b31a5da 100644
--- a/staging/ext-image-capture-source/ext-image-capture-source-v1.xml
+++ b/staging/ext-image-capture-source/ext-image-capture-source-v1.xml
@@ -39,7 +39,7 @@
     only be done by creating a new major version of the extension.
   </description>
 
-  <interface name="ext_image_capture_source_v1" version="1" frozen="true">
+  <interface name="ext_image_capture_source_v1" version="1">
     <description summary="opaque image capture source object">
       The image capture source object is an opaque descriptor for a capturable
       resource.  This resource may be any sort of entity from which an image
-- 
2.55.0

