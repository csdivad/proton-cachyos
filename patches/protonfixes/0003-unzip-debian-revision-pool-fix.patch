# [fork-local] unzip 6.0-29 was pruned from Debian's pool (superseded by 29+deb13u1),
# so the pinned protonfixes Makefile 404s and redist aborts in protonfixes-x86_64-build.
# Drop-in for <proton tree>/patches/protonfixes/ (applied with patch -Np1 inside the
# protonfixes checkout by patches/protonprep-valve-staging.sh / Makefile.in post-source).
# Delete this file once the protonfixes submodule pin is >= 509f7a4e1b (upstream fix).
diff --git a/Makefile b/Makefile
index 4dcd851..9a88801 100644
--- a/Makefile
+++ b/Makefile
@@ -145,7 +145,7 @@ DEFINES = -DACORN_FTYPE_NFS -DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT \
  -DDATE_FORMAT=DF_YMD -DUSE_BZIP2 -DIZ_HAVE_UXUIDGID -DNOMEMCPY \
  -DNO_WORKING_ISPRINT
 UNZIP_VERSION := 6.0
-UNZIP_DEBIAN_REVISION := 29
+UNZIP_DEBIAN_REVISION := 29+deb13u1
 UNZIP_BASE_URL := https://deb.debian.org/debian/pool/main/u/unzip
 UNZIP_ORIG_TARBALL := unzip_$(UNZIP_VERSION).orig.tar.gz
 UNZIP_DEBIAN_TARBALL := unzip_$(UNZIP_VERSION)-$(UNZIP_DEBIAN_REVISION).debian.tar.xz
