From 41301fe207b8f63b80dd9e8d41a9ece01b35ec6b Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Mon, 19 Oct 2026 12:00:00 -0600
Subject: [PATCH] vkd3d: Don't read the parent process image for engine
 detection.

Commit 142d72f ("vkd3d: Also try to detect UE version from parent
process.") reads the parent process's version resource with
GetFileVersionInfo(), which maps the parent's executable into the game
process. When the parent is an Easy Anti-Cheat bootstrapper, EAC sees
that image and kicks the game with "Violation 8 - Untrusted system file":
Star Citizen flags StarCitizen_Launcher.exe (error 30033) and Hunt:
Showdown flags hunt.exe. Inside Steam the EAC runtime hides it, but
non-Steam launches such as the RSI launcher are affected since
GE-Proton11-7, which was the first release with that commit.

Drop the parent-process probe. Unreal Engine detection falls back to the
game's own image, the existing filesystem checks and (since d0890b2d)
the numeric product-version fallback on the game's own executable.

Regenerated against vkd3d-proton d0890b2d: upstream added a
known_unreal_engine parameter to get_engine_version_from_exe(), so the
parent-probe hunk no longer applied; the removed probe is unchanged in
behaviour.

https://github.com/GloriousEggroll/proton-ge-custom/issues/858
https://github.com/HansKristian-Work/vkd3d-proton/issues/3348
---
 libs/vkd3d-common/platform.c | 27 ++++-----------------------
 1 file changed, 4 insertions(+), 23 deletions(-)

diff --git a/libs/vkd3d-common/platform.c b/libs/vkd3d-common/platform.c
index e93cbf7..55359b7 100644
--- a/libs/vkd3d-common/platform.c
+++ b/libs/vkd3d-common/platform.c
@@ -289,8 +289,6 @@ enum vkd3d_application_engine_class vkd3d_get_engine_version(uint32_t *major, ui
     WCHAR exe_path[VKD3D_PATH_MAX], path[VKD3D_PATH_MAX];
     enum vkd3d_application_engine_class engine_class;
     const WCHAR *name;
-    HMODULE ntdll;
-    DWORD size;
 
     *major = *minor = *patch = 0;
     GetModuleFileNameW(NULL, exe_path, VKD3D_PATH_MAX);
@@ -310,27 +308,10 @@ enum vkd3d_application_engine_class vkd3d_get_engine_version(uint32_t *major, ui
     if ((engine_class = get_engine_version_from_exe(path, major, minor, patch, false)))
         return engine_class;
 
-    if ((ntdll = GetModuleHandleA("ntdll.dll")))
-    {
-        PFN_NtQueryInformationProcess pfn_NtQueryInformationProcess;
-        PROCESS_BASIC_INFORMATION pbi;
-        HANDLE parent;
-
-        pfn_NtQueryInformationProcess =
-            (PFN_NtQueryInformationProcess)(void *)GetProcAddress(ntdll, "NtQueryInformationProcess");
-
-        if (pfn_NtQueryInformationProcess &&
-            !pfn_NtQueryInformationProcess(GetCurrentProcess(), ProcessBasicInformation, &pbi, sizeof(pbi), NULL) &&
-           (parent = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, (DWORD)pbi.InheritedFromUniqueProcessId)))
-        {
-            size = ARRAY_SIZE(path);
-            if (QueryFullProcessImageNameW(parent, 0, path, &size))
-                engine_class = get_engine_version_from_exe(path, major, minor, patch, false);
-            CloseHandle(parent);
-            if (engine_class)
-                return engine_class;
-        }
-    }
+    /* Don't read the parent process's image for its version info.
+     * GetFileVersionInfo() maps the file into this process, and when the
+     * parent is an EAC bootstrapper (e.g. StarCitizen_Launcher.exe, hunt.exe)
+     * EAC reports it as an untrusted system file and kicks the game. */
 
     /* Dubious checks where we spelunk the filesystem. */
 
-- 
